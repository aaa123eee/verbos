---
// The conjugation trainer: the main page of the site.
import Base from "../layouts/Base.astro";
import TrainerNav from "../components/TrainerNav.astro";
import SearchBox from "../components/SearchBox.astro";
import Support from "../components/Support.astro";
import WineButton from "../components/WineButton.astro";
import "../styles/conjugacion.css";
import { tensesHtml, DEFAULT_TENSES } from "../lib/conjugation.js";
---
<Base title="Conjugación española">
<div class="app">
  <header class="top">
    <h1 class="brand"><span>Conjugación</span> <em>española</em></h1>
    <nav class="tools" aria-label="Шпаргалка"><button type="button" class="ghost" data-open="regular" title="Правильные глаголы"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg><span>Правильные</span></button><button type="button" class="ghost" data-open="irregular" title="Неправильные глаголы"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg><span>Неправильные</span></button><button type="button" class="ghost" data-open="other" title="Остальные времена"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Остальные времена</span></button></nav>
    <SearchBox />
    <span class="sep" aria-hidden="true"></span>
    <a class="ghost fyi" href="#about" title="Как это работает"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 16v-5M12 8h.01"/></svg><span>Что это?</span></a>
    <button type="button" class="ghost only-m" id="cfgOpen" aria-controls="side" aria-expanded="false" title="Настройки"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/></svg><span>Настройки</span></button>
    <WineButton />
  </header>
  <TrainerNav current="conjugacion" />

  <aside class="side" id="side" aria-label="Настройки" tabindex="-1">
    <div class="side-head only-m"><h2>Настройки</h2><button type="button" class="ghost" id="cfgClose" aria-label="Закрыть"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <section>
      <h3>Времена</h3>
      <div class="tenses" id="tenses" role="group" aria-label="Времена" set:html={tensesHtml(DEFAULT_TENSES)}></div>
    </section>
    <section>
      <h3>Глаголы</h3>
      <div class="filters">
        <div class="seg" role="radiogroup" aria-label="Глаголы"><span class="cap">Тип</span>
          <label><input type="radio" name="group" id="g-all" value="all" checked><span>Все</span></label>
          <label><input type="radio" name="group" id="g-reg" value="reg"><span>Правильные</span></label>
          <label><input type="radio" name="group" id="g-irr" value="irr"><span>Неправильные</span></label>
        </div>
        <div class="seg" role="radiogroup" aria-label="Набор глаголов"><span class="cap">Набор</span>
          <label><input type="radio" name="tier" id="l-1" value="1" checked><span>Основные</span></label>
          <label><input type="radio" name="tier" id="l-2" value="2"><span>Частые</span></label>
          <label><input type="radio" name="tier" id="l-3" value="3"><span>Регулярно используемые</span></label>
          <label><input type="radio" name="tier" id="l-4" value="4"><span>Расширенные</span></label>
          <label><input type="radio" name="tier" id="l-5" value="5"><span>Все остальные (8 тыс.)</span></label>
          <label><input type="radio" name="tier" id="l-all" value="all"><span>Все</span></label>
        </div>
      </div>
    </section>
    <section>
      <h3>Задание</h3>
      <div class="filters">
        <div class="seg" role="radiogroup" aria-label="Язык задания"><span class="cap">Язык задания</span>
          <label><input type="radio" name="mode" id="m-es" value="es" checked><span>yo · hablar</span></label>
          <label><input type="radio" name="mode" id="m-ru" value="ru"><span>я говорю</span></label>
          <label><input type="radio" name="mode" id="m-mix" value="mix"><span>Вперемешку</span></label>
        </div>
        <div class="seg"><span class="cap">Проверка</span><label class="check"><input type="checkbox" id="strict" checked> Ударения считаются</label>
        <label class="check"><input type="checkbox" id="vos" checked> С vosotros</label></div>
      </div>
    </section>
    <section>
      <h3>Прогресс</h3>
      <div class="stats loading" id="stats">{["ответов","верно","серия","на повторении"].map((t) => <span>{t} <b></b></span>)}</div>
      <div class="weak">
        <h3>Сейчас на повторении</h3>
        <div class="chips" id="weak"></div>
      </div>
      <div class="foot">
        <span class="empty" id="syncNote">Прогресс хранится в этом браузере.</span>
        <span class="resets"><button type="button" id="reset" data-label="Сбросить прогресс"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg><span>Сбросить прогресс</span></button><button type="button" id="resetAll" data-label="Сбросить всё"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/></svg><span>Сбросить всё</span></button></span>
      </div>
    </section>
  </aside>
  <div class="scrim" id="scrim" hidden></div>

  <main class="main" id="trainer">
    <Support />
    <div class="trainer loading conj-main">
      <div class="prompt" aria-live="polite">
        <div class="tense"><span class="pill" id="pTense">presente</span><span class="when" id="pWhen">настоящее · сейчас</span><span class="mini" id="mini" data-empty>серия <b></b> · верно <b></b></span></div>
        <div class="q"><span class="pron" id="pPron">yo</span><span class="pron" id="pSep"> · </span><span id="pVerb">hablar</span></div>
        <div class="ru" id="pRu">разговаривать</div>
        <div class="tag" id="pTag"></div>
      </div>

      <div class="answer">
        <input id="ans" type="text" autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off" aria-label="Твой ответ" placeholder="форма глагола">
      </div>
      <div class="drill" id="drill" hidden></div>
      <div class="aux">
        <div class="acts"><button class="primary" type="button" id="go"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Проверить</span><kbd>Enter ↵</kbd></button><button type="button" id="undo" disabled title="Отменить ответ и ответить заново (Esc)"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg><span>Отменить</span><kbd>Esc</kbd></button></div>
        <div class="keys" aria-label="Буквы с ударением">
          <button type="button" data-k="á">á</button><button type="button" data-k="é">é</button><button type="button" data-k="í">í</button><button type="button" data-k="ó">ó</button><button type="button" data-k="ú">ú</button><button type="button" data-k="ñ">ñ</button>
        </div>
      </div>
      <div class="hintbar" id="hintbar" role="group" aria-label="Подсказки">
        <span class="hl">Подсказки</span>
        <button type="button" data-h="rule"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z"/></svg><span>Правило</span></button>
        <button type="button" data-h="reg"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg><span>Правильный?</span></button>
        <button type="button" data-h="end"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg><span>Окончания</span></button>
        <button type="button" data-h="letter"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg><span>Буква</span></button>
      </div>
      <div class="hints" id="hints" hidden></div>

      <div class="feedback idle" id="fb">Enter — проверить, ещё раз Enter — следующий вопрос. Esc — отменить ответ, если ошибся по невнимательности.</div>
    </div>
  </main>

  <footer class="about" id="about">
    <h2>Как это работает</h2>
    <p>Тренажёр спряжения испанских глаголов без вариантов ответа: пишешь форму сам и сразу видишь, верно или нет. При ошибке показано, где она, какое правило работает, как форма строится из инфинитива, и всё время целиком для этого глагола.</p>
    <ul>
      <li><b>Enter</b> — проверить, ещё раз Enter — следующий вопрос. <b>Esc</b> — отменить ответ, если ошибся по невнимательности.</li>
      <li>Ошибки возвращаются через несколько вопросов, пока не ответишь правильно три раза. Вопрос, на который ответил с подсказкой или после отмены, вернётся один раз, чтобы ответить чисто.</li>
      <li>Две ошибки в одном глаголе и времени — и придётся написать все формы этого времени по памяти, строка за строкой.</li>
      <li>Подсказки — правило, правильный ли глагол, окончания, следующая буква — под полем ответа, по кнопкам.</li>
      <li>Времена, набор глаголов и язык задания — в настройках: слева на компьютере, за кнопкой «Настройки» на телефоне. По умолчанию presente и pretérito.</li>
      <li>Шпаргалка с окончаниями и правилами и поиск глагола — кнопки вверху страницы. Поиск понимает и испанский, и русский: «говорить» найдёт hablar и decir, «сказал» — decir, «tuve» — tener.</li>
      <li>286 частых глаголов в четырёх наборах, а в пятом — все остальные испанские глаголы из Викисловаря (около 8,4 тыс.), и все 18 времён. Каждая форма сверена с таблицами Викисловаря. Задания по-русски — только для первых четырёх наборов. Книжные времена (pretérito anterior, futuro de subjuntivo) по умолчанию выключены. Форма на -se (hablase) засчитывается наравне с -ra.</li>
      <li>Прогресс хранится только в этом браузере: без аккаунта и сервера.</li>
    </ul>
  </footer>
</div>

<dialog class="sheet" id="sheet" aria-label="Шпаргалка">
  <div class="sheet-head">
    <div class="tabs" role="tablist"><button type="button" role="tab" data-tab="regular"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg><span>Правильные</span></button><button type="button" role="tab" data-tab="irregular"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg><span>Неправильные</span></button><button type="button" role="tab" data-tab="other"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Остальные времена</span></button><button type="button" role="tab" data-tab="search"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Поиск глагола</span></button></div>
    <button type="button" class="close" id="sheetClose" aria-label="Закрыть"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="sheet-body" id="sheetBody">
  <section class="panel" id="regular" role="tabpanel" hidden>
    <h2>Правильные глаголы</h2>
    <p>Отрезаешь <span class="f">-ar / -er / -ir</span> и добавляешь окончание. У <span class="f">-er</span> и <span class="f">-ir</span> окончания почти совпадают: в presente отличаются только nosotros и vosotros, в pretérito они одинаковые.</p>
    <div class="grid2">
      <div class="block">
        <h3>Presente</h3>
        <div class="tbl"><table>
          <thead><tr><th></th><th>-ar · hablar</th><th>-er · comer</th><th>-ir · vivir</th></tr></thead>
          <tbody>
            <tr><td class="p">yo</td><td class="f">habl<span class="e">o</span></td><td class="f">com<span class="e">o</span></td><td class="f">viv<span class="e">o</span></td></tr>
            <tr><td class="p">tú</td><td class="f">habl<span class="e">as</span></td><td class="f">com<span class="e">es</span></td><td class="f">viv<span class="e">es</span></td></tr>
            <tr><td class="p">él / ella / Ud.</td><td class="f">habl<span class="e">a</span></td><td class="f">com<span class="e">e</span></td><td class="f">viv<span class="e">e</span></td></tr>
            <tr><td class="p">nosotros</td><td class="f">habl<span class="e">amos</span></td><td class="f">com<span class="e">emos</span></td><td class="f">viv<span class="e">imos</span></td></tr>
            <tr><td class="p">vosotros</td><td class="f">habl<span class="e">áis</span></td><td class="f">com<span class="e">éis</span></td><td class="f">viv<span class="e">ís</span></td></tr>
            <tr><td class="p">ellos / Uds.</td><td class="f">habl<span class="e">an</span></td><td class="f">com<span class="e">en</span></td><td class="f">viv<span class="e">en</span></td></tr>
          </tbody></table></div>
        <div class="note"><span>Гласная окончания «переворачивается»: у <b>-ar</b> везде <b>a</b>, у <b>-er/-ir</b> везде <b>e</b>. Кроме yo — там всегда <b>-o</b>.</span></div>
      </div>
      <div class="block">
        <h3>Pretérito indefinido</h3>
        <div class="tbl"><table>
          <thead><tr><th></th><th>-ar · hablar</th><th>-er · comer</th><th>-ir · vivir</th></tr></thead>
          <tbody>
            <tr><td class="p">yo</td><td class="f">habl<span class="e">é</span></td><td class="f">com<span class="e">í</span></td><td class="f">viv<span class="e">í</span></td></tr>
            <tr><td class="p">tú</td><td class="f">habl<span class="e">aste</span></td><td class="f">com<span class="e">iste</span></td><td class="f">viv<span class="e">iste</span></td></tr>
            <tr><td class="p">él / ella / Ud.</td><td class="f">habl<span class="e">ó</span></td><td class="f">com<span class="e">ió</span></td><td class="f">viv<span class="e">ió</span></td></tr>
            <tr><td class="p">nosotros</td><td class="f">habl<span class="e">amos</span></td><td class="f">com<span class="e">imos</span></td><td class="f">viv<span class="e">imos</span></td></tr>
            <tr><td class="p">vosotros</td><td class="f">habl<span class="e">asteis</span></td><td class="f">com<span class="e">isteis</span></td><td class="f">viv<span class="e">isteis</span></td></tr>
            <tr><td class="p">ellos / Uds.</td><td class="f">habl<span class="e">aron</span></td><td class="f">com<span class="e">ieron</span></td><td class="f">viv<span class="e">ieron</span></td></tr>
          </tbody></table></div>
        <div class="note"><span>Ударение на yo и él решает смысл: <span class="f">hablo</span> «я говорю» ≠ <span class="f">habló</span> «он сказал».</span><span><span class="f">hablamos</span> и <span class="f">vivimos</span> одинаковы в обоих временах, время понятно из контекста.</span></div>
      </div>
    </div>
    <div class="block" id="vocab"></div>
  </section>

  <section class="panel" id="irregular" role="tabpanel" hidden>
    <h2>Неправильные глаголы</h2>
    <ul class="rules">
      <li><b>Yo на -go</b> в presente, остальное обычно: tener → <span class="f">ten<span class="x">go</span></span>, hacer → <span class="f">ha<span class="x">go</span></span>, poner, salir, venir, decir.</li>
      <li><b>Смена корня в presente</b> во всех формах, кроме nosotros и vosotros: <span class="f">e→ie</span> (qu<span class="x">ie</span>ro), <span class="f">o→ue</span> (p<span class="x">ue</span>do), <span class="f">e→i</span> (d<span class="x">i</span>go).</li>
      <li><b>«Сильный» pretérito</b>: новый корень + <span class="f e">-e, -iste, -o, -imos, -isteis, -ieron</span>, без ударений. tuv-, estuv-, hic-, pud-, quis-, vin-, pus-, sup-. У hacer в él: <span class="f">hi<span class="x">z</span>o</span>.</li>
      <li>Корень на <b>-j</b> (dij-) даёт <span class="f">dij<span class="x">eron</span></span>, без i.</li>
      <li><b>ser и ir</b> в pretérito одинаковые: <span class="f">fui, fuiste, fue…</span></li>
      <li><b>dar, ver</b>: короткие формы без ударений — <span class="f">di, dio, vi, vio</span>.</li>
      <li><b>-ir со сменой корня</b> меняются и в pretérito, но только в él и ellos: <span class="f">e→i</span> (p<span class="x">i</span>dió, s<span class="x">i</span>ntieron), <span class="f">o→u</span> (d<span class="x">u</span>rmió, m<span class="x">u</span>rieron). У -ar и -er в pretérito корень не меняется: pensé, volví.</li>
      <li><b>Орфография в yo pretérito</b>, чтобы сохранить звук: <span class="f">-car → -<span class="x">qu</span>é</span> (busqué), <span class="f">-gar → -<span class="x">gu</span>é</span> (llegué), <span class="f">-zar → -<span class="x">c</span>é</span> (empecé).</li>
      <li><b>i → y</b> между гласными: le<span class="x">y</span>ó, o<span class="x">y</span>eron, ca<span class="x">y</span>ó, cre<span class="x">y</span>eron.</li>
      <li><b>-cer, -cir → -zco</b> в yo: cono<span class="x">zc</span>o, condu<span class="x">zc</span>o. У -ducir ещё и pretérito на j: <span class="f">conduje, condujeron</span>.</li>
    </ul>
    <div class="block" id="irrTables"></div>
  </section>

  <section class="panel" id="other" role="tabpanel" hidden>
    <h2>Остальные времена</h2>
    <p>Все эти времена строятся по правилам из нескольких строк. Неправильных глаголов здесь гораздо меньше, чем в presente и pretérito.</p>
    <div class="grid2">
      <div class="block">
        <h3>Pretérito imperfecto · фон, привычка</h3>
        <div class="tbl"><table>
          <thead><tr><th></th><th>-ar · hablar</th><th>-er / -ir · comer</th><th>ser</th><th>ir</th><th>ver</th></tr></thead>
          <tbody>
            <tr><td class="p">yo</td><td class="f">habl<span class="e">aba</span></td><td class="f">com<span class="e">ía</span></td><td class="f">era</td><td class="f">iba</td><td class="f">veía</td></tr>
            <tr><td class="p">tú</td><td class="f">habl<span class="e">abas</span></td><td class="f">com<span class="e">ías</span></td><td class="f">eras</td><td class="f">ibas</td><td class="f">veías</td></tr>
            <tr><td class="p">él</td><td class="f">habl<span class="e">aba</span></td><td class="f">com<span class="e">ía</span></td><td class="f">era</td><td class="f">iba</td><td class="f">veía</td></tr>
            <tr><td class="p">nosotros</td><td class="f">habl<span class="e">ábamos</span></td><td class="f">com<span class="e">íamos</span></td><td class="f">éramos</td><td class="f">íbamos</td><td class="f">veíamos</td></tr>
            <tr><td class="p">vosotros</td><td class="f">habl<span class="e">abais</span></td><td class="f">com<span class="e">íais</span></td><td class="f">erais</td><td class="f">ibais</td><td class="f">veíais</td></tr>
            <tr><td class="p">ellos</td><td class="f">habl<span class="e">aban</span></td><td class="f">com<span class="e">ían</span></td><td class="f">eran</td><td class="f">iban</td><td class="f">veían</td></tr>
          </tbody></table></div>
        <div class="note"><span>Неправильных всего три: <b>ser, ir, ver</b>. Остальные, даже tener и hacer, правильные: tenía, hacía.</span></div>
      </div>
      <div class="block">
        <h3>Futuro y condicional · к инфинитиву</h3>
        <div class="tbl"><table>
          <thead><tr><th></th><th>futuro</th><th>condicional</th></tr></thead>
          <tbody>
            <tr><td class="p">yo</td><td class="f">hablar<span class="e">é</span></td><td class="f">hablar<span class="e">ía</span></td></tr>
            <tr><td class="p">tú</td><td class="f">hablar<span class="e">ás</span></td><td class="f">hablar<span class="e">ías</span></td></tr>
            <tr><td class="p">él</td><td class="f">hablar<span class="e">á</span></td><td class="f">hablar<span class="e">ía</span></td></tr>
            <tr><td class="p">nosotros</td><td class="f">hablar<span class="e">emos</span></td><td class="f">hablar<span class="e">íamos</span></td></tr>
            <tr><td class="p">vosotros</td><td class="f">hablar<span class="e">éis</span></td><td class="f">hablar<span class="e">íais</span></td></tr>
            <tr><td class="p">ellos</td><td class="f">hablar<span class="e">án</span></td><td class="f">hablar<span class="e">ían</span></td></tr>
          </tbody></table></div>
        <div class="note"><span>Окончания одни для -ar, -er, -ir: они добавляются к целому инфинитиву.</span><span>Особые основы: <span class="f">tendr- pondr- saldr- vendr- podr- sabr- querr- har- dir- valdr- cabr-</span>, и так же с приставками: <span class="f">mantendr-, supondr-, prevendr-, deshar-</span>. oír → <span class="f">oiré</span> (без ударения на i).</span></div>
      </div>
      <div class="block">
        <h3>Составные · haber + participio</h3>
        <div class="tbl"><table>
          <thead><tr><th></th><th>perfecto</th><th>pluscuamp.</th><th>anterior</th><th>futuro perf.</th><th>cond. perf.</th><th>subj. perf.</th><th>subj. pluscuamp.</th><th>subj. futuro perf.</th></tr></thead>
          <tbody>
            <tr><td class="p">yo</td><td class="f">he</td><td class="f">había</td><td class="f">hube</td><td class="f">habré</td><td class="f">habría</td><td class="f">haya</td><td class="f">hubiera</td><td class="f">hubiere</td></tr>
            <tr><td class="p">tú</td><td class="f">has</td><td class="f">habías</td><td class="f">hubiste</td><td class="f">habrás</td><td class="f">habrías</td><td class="f">hayas</td><td class="f">hubieras</td><td class="f">hubieres</td></tr>
            <tr><td class="p">él</td><td class="f">ha</td><td class="f">había</td><td class="f">hubo</td><td class="f">habrá</td><td class="f">habría</td><td class="f">haya</td><td class="f">hubiera</td><td class="f">hubiere</td></tr>
            <tr><td class="p">nosotros</td><td class="f">hemos</td><td class="f">habíamos</td><td class="f">hubimos</td><td class="f">habremos</td><td class="f">habríamos</td><td class="f">hayamos</td><td class="f">hubiéramos</td><td class="f">hubiéremos</td></tr>
            <tr><td class="p">vosotros</td><td class="f">habéis</td><td class="f">habíais</td><td class="f">hubisteis</td><td class="f">habréis</td><td class="f">habríais</td><td class="f">hayáis</td><td class="f">hubierais</td><td class="f">hubiereis</td></tr>
            <tr><td class="p">ellos</td><td class="f">han</td><td class="f">habían</td><td class="f">hubieron</td><td class="f">habrán</td><td class="f">habrían</td><td class="f">hayan</td><td class="f">hubieran</td><td class="f">hubieren</td></tr>
          </tbody></table></div>
        <div class="note"><span>Participio: <span class="f">-ar → -<span class="e">ado</span></span>, <span class="f">-er/-ir → -<span class="e">ido</span></span>. Неправильные: <span class="f">hecho, dicho, puesto, visto, escrito, abierto, vuelto, muerto, roto, cubierto, resuelto</span> и производные: <span class="f">supuesto, deshecho, devuelto, descrito, descubierto</span>. С ударением: <span class="f">leído, creído, oído, traído, caído</span>.</span><span>Отвечать нужно двумя словами: <span class="f">he hablado</span>.</span></div>
      </div>
      <div class="block">
        <h3>Subjuntivo presente · que hable</h3>
        <div class="tbl"><table>
          <thead><tr><th></th><th>-ar · hablar</th><th>-er/-ir · comer</th><th>tener (yo tengo)</th></tr></thead>
          <tbody>
            <tr><td class="p">yo</td><td class="f">habl<span class="e">e</span></td><td class="f">com<span class="e">a</span></td><td class="f">teng<span class="e">a</span></td></tr>
            <tr><td class="p">tú</td><td class="f">habl<span class="e">es</span></td><td class="f">com<span class="e">as</span></td><td class="f">teng<span class="e">as</span></td></tr>
            <tr><td class="p">él</td><td class="f">habl<span class="e">e</span></td><td class="f">com<span class="e">a</span></td><td class="f">teng<span class="e">a</span></td></tr>
            <tr><td class="p">nosotros</td><td class="f">habl<span class="e">emos</span></td><td class="f">com<span class="e">amos</span></td><td class="f">teng<span class="e">amos</span></td></tr>
            <tr><td class="p">vosotros</td><td class="f">habl<span class="e">éis</span></td><td class="f">com<span class="e">áis</span></td><td class="f">teng<span class="e">áis</span></td></tr>
            <tr><td class="p">ellos</td><td class="f">habl<span class="e">en</span></td><td class="f">com<span class="e">an</span></td><td class="f">teng<span class="e">an</span></td></tr>
          </tbody></table></div>
        <div class="note"><span>Берёшь yo из presente, убираешь <b>-o</b> и ставишь «чужую» гласную: у -ar <b>e</b>, у -er/-ir <b>a</b>.</span><span>Смена корня e→ie / o→ue не идёт в nosotros и vosotros (pensemos, volvamos). У -ir там e→i / o→u: sintamos, durmamos.</span><span>Орфография: busque, llegue, empiece. Исключения: <span class="f">sea, esté, vaya, sepa, dé</span>.</span></div>
      </div>
      <div class="block">
        <h3>Subjuntivo imperfecto · que hablara</h3>
        <div class="note"><span>Берёшь ellos из pretérito, убираешь <b>-ron</b> и добавляешь <span class="f e">-ra, -ras, -ra, -ramos, -rais, -ran</span>.</span><span><span class="f">hablaron → hablara</span>, <span class="f">tuvieron → tuviera</span>, <span class="f">fueron → fuera</span>, <span class="f">dijeron → dijera</span>.</span><span>В nosotros ударение на гласную перед -ramos: <span class="f">habláramos, tuviéramos, fuéramos</span>.</span><span>Вариант на -se тоже правильный и засчитывается: <span class="f">hablase, tuviese, hubiese hablado</span>.</span></div>
      </div>
      <div class="block">
        <h3>Imperativo afirmativo · ¡habla!</h3>
        <div class="note"><span><b>tú</b> = él из presente: habla, come, piensa. Особые: <span class="f">di, haz, ve, pon, sal, sé, ten, ven</span>, с приставками — с ударением: <span class="f">mantén, supón, prevén, deshaz</span>.</span><span><b>usted, ustedes, nosotros</b> = subjuntivo presente: hable, hablen, hablemos. Для ir в nosotros — <span class="f">vamos</span>.</span><span><b>vosotros</b> = инфинитив без -r + <b>d</b>: hablad, comed, id.</span><span>Формы для yo нет.</span></div>
      </div>
      <div class="block">
        <h3>Imperativo negativo · ¡no hables!</h3>
        <div class="note"><span>Для всех лиц: <b>no + subjuntivo presente</b>. Особой формы tú и окончания -d здесь нет.</span><span><span class="f">habla → no hables</span>, <span class="f">di → no digas</span>, <span class="f">hablad → no habléis</span>, <span class="f">id → no vayáis</span>.</span><span>Отвечать нужно вместе с no: <span class="f">no hables</span>.</span></div>
      </div>
      <div class="block">
        <h3>Книжные времена</h3>
        <div class="note"><span><b>Pretérito anterior</b>: haber в pretérito + participio — <span class="f">hube, hubiste, hubo, hubimos, hubisteis, hubieron hablado</span>. «Как только сделал»: <i>cuando hubo terminado</i>. В речи его заменяют pretérito.</span><span><b>Futuro de subjuntivo</b>: как subjuntivo imperfecto, но с <span class="f e">-re</span>: <span class="f">hablare, tuviere, fuere</span>, nosotros с ударением: <span class="f">habláremos</span>. Встречается в законах и выражениях: <i>sea lo que fuere</i>.</span><span><b>Futuro perfecto de subjuntivo</b>: <span class="f">hubiere, hubieres… + participio</span>.</span><span>По умолчанию эти времена не выбраны: их стоит знать в лицо, но говорить так почти не придётся.</span></div>
      </div>
    </div>
  </section>
